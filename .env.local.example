# ─── MODEL AI ────────────────────────────────────────────────────────────────
# Domyślnie Gemini (darmowy tier). Klucz: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
# Aktualna lista modeli: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Alternatywy — wystarczy zmienić AI_PROVIDER i wypełnić właściwy klucz
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# ─── ŹRÓDŁA OFERT ────────────────────────────────────────────────────────────
# CBOP (urzędy pracy) — dane publiczne, nie wymaga klucza. Włączone domyślnie.
SOURCE_CBOP=on

# Adzuna — darmowy tier. Rejestracja: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — darmowy klucz na wniosek: https://pl.jooble.org/api/about
JOOBLE_API_KEY=

# EURES — oficjalne API Komisji Europejskiej, bez klucza
SOURCE_EURES=on

# ─── WTYCZKA DO PRZEGLĄDARKI ─────────────────────────────────────────────────
# Wspólny sekret między wtyczką a aplikacją (wpisz cokolwiek długiego i losowego)
INGEST_TOKEN=zmien-mnie-na-dlugi-losowy-ciag
