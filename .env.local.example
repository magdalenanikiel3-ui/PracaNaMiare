# ─── MODEL AI ────────────────────────────────────────────────────────────────
# Domyślnie Gemini (darmowy tier). Klucz: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
# Aktualna lista modeli: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# ─── LIMITY ZAPYTAŃ ──────────────────────────────────────────────────────────
# Ile zapytań na minutę wolno wysłać do modelu.
# Darmowy tier Gemini Flash: 10/min, 1500/dobę — i to jest wartość domyślna.
# Po włączeniu płatnego rozliczenia w Google AI Studio podnieś to śmiało
# do 150 lub więcej, a kolejka praktycznie zniknie.
AI_MAX_RPM=10

# Ile ofert trafia do oceny przez AI. Każde 8 ofert = jedno zapytanie.
# Przy darmowym limicie 12 to bezpieczna wartość. Przy płatnym: 24–48.
RERANK_MAX_OFFERS=12

# Alternatywy — wystarczy zmienić AI_PROVIDER i wypełnić właściwy klucz
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# ─── ŹRÓDŁA OFERT ────────────────────────────────────────────────────────────
# CBOP (urzędy pracy) — dane publiczne, nie wymaga klucza. Włączone domyślnie.
SOURCE_CBOP=on

# Adzuna — darmowy tier. Rejestracja: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — darmowy klucz na wniosek: https://pl.jooble.org/api/about
JOOBLE_API_KEY=

# EURES — oficjalne API Komisji Europejskiej, bez klucza
SOURCE_EURES=on

# ─── WTYCZKA DO PRZEGLĄDARKI ─────────────────────────────────────────────────
# Wspólny sekret między wtyczką a aplikacją (wpisz cokolwiek długiego i losowego)
INGEST_TOKEN=zmien-mnie-na-dlugi-losowy-ciag
